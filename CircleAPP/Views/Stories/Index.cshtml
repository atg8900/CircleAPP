@model List<Story>

<main id="site__main" class="2xl:ml-[--w-side] xl:ml-[--w-side-sm] p-2.5 h-[calc(100vh-var(--m-top))] mt-[--m-top]">
    <div class="lg:flex 2xl:gap-16 gap-12 max-w-[1065px] mx-auto" id="js-oversized">
        <div class="max-w-[680px] mx-auto w-full">

            @* Stories Section *@
            <div class="mb-8 bg-white rounded-2xl shadow-sm border border-gray-100 px-4 py-4">

                <div class="relative" tabindex="-1" uk-slider="auto play: true; finite: true">

                    <div class="uk-slider-container overflow-hidden">
                        <ul class="uk-slider-items flex gap-3 w-[calc(100%+12px)]"
                            uk-scrollspy="target: > li; cls: uk-animation-fade; delay: 30; repeat: true">

                            @* Add Story Button *@
                            <li class="pr-2 flex-shrink-0" uk-scrollspy-class="uk-animation-fade">
                                <div uk-toggle="target: #create-story"
                                     class="relative flex flex-col items-center justify-center gap-2 cursor-pointer group w-28 h-48 rounded-2xl border-2 border-dashed border-gray-300 bg-gradient-to-br from-gray-50 to-gray-100 group-hover:from-indigo-50 group-hover:to-purple-50 group-hover:border-indigo-300 transition-all duration-300 overflow-hidden">
                                    <div class="w-10 h-10 rounded-full bg-gradient-to-br from-indigo-500 to-purple-500
                                        grid place-items-center shadow-sm">
                                        <ion-icon name="add" class="text-white text-xl"></ion-icon>
                                    </div>
                                    <span class="text-xs font-medium text-gray-500 group-hover:text-indigo-500
                                        transition-colors duration-200 text-center">
                                        Add story
                                    </span>
                                </div>
                            </li>

                            @* Story Items *@
                            @foreach (var story in Model)
                            {
                                <li class="pr-2 flex-shrink-0 hover:scale-105 hover:-rotate-1 duration-300 ease-out">
                                    <div onclick="openStory('@story.ImageUrl', '@story.User.ProfilePictureUrl', '@story.User.FullName')"
                                         class="flex flex-col items-center gap-2 group w-28 cursor-pointer">

                                        <div class="relative w-28 h-48 rounded-2xl overflow-hidden shadow-md
                                            group-hover:shadow-lg transition-shadow duration-300">

                                            @* Story background image *@
                                            <img src="@story.ImageUrl"
                                                 alt="@story.User.FullName's story"
                                                 class="w-full h-full object-cover" />

                                            @* Dark gradient overlay *@
                                            <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-transparent to-black/30 rounded-2xl"></div>

                                            @* Profile picture + name at top *@
                                            <div class="absolute top-3 left-3 right-3 flex items-center gap-2">
                                                <div class="w-9 h-9 rounded-full p-[2px] shrink-0
                                                    bg-gradient-to-tr from-orange-400 via-pink-500 to-purple-500
                                                    group-hover:from-yellow-400 group-hover:via-pink-500 group-hover:to-indigo-500
                                                    transition-all duration-300 shadow-sm">
                                                    <div class="w-full h-full rounded-full border-[1.5px] border-white overflow-hidden bg-gray-100">
                                                        <img src="@story.User.ProfilePictureUrl"
                                                             alt="@story.User.FullName"
                                                             class="w-full h-full object-cover" />
                                                    </div>
                                                </div>
                                                <span class="text-xs font-semibold text-white leading-tight truncate drop-shadow-md">
                                                    @story.User.FullName
                                                </span>
                                            </div>

                                        </div>
                                    </div>
                                </li>
                            }

                            @* Loading skeleton *@
                            <li class="pr-2 flex-shrink-0 flex flex-col items-center gap-2">
                                <div class="w-28 h-48 rounded-2xl bg-gradient-to-br from-gray-200 to-gray-100 animate-pulse"></div>
                            </li>

                        </ul>
                    </div>

                    @* Slider nav arrows *@
                    <a class="uk-position-center-left-out uk-position-small hidden md:flex items-center justify-center
                        w-8 h-8 rounded-full bg-white shadow-md border border-gray-100
                        hover:shadow-lg transition-shadow duration-200"
                       href="#" uk-slider-item="previous">
                        <ion-icon name="chevron-back" class="text-gray-600 text-sm"></ion-icon>
                    </a>
                    <a class="uk-position-center-right-out uk-position-small hidden md:flex items-center justify-center
                        w-8 h-8 rounded-full bg-white shadow-md border border-gray-100
                        hover:shadow-lg transition-shadow duration-200"
                       href="#" uk-slider-item="next">
                        <ion-icon name="chevron-forward" class="text-gray-600 text-sm"></ion-icon>
                    </a>

                </div>
            </div>

        </div>
    </div>
</main>

@* ── Story Viewer Modal ── *@
<div id="storyModal"
     class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 backdrop-blur-sm"
     onclick="closeStoryBackdrop(event)">

    <div class="relative w-[340px] h-[600px] rounded-3xl overflow-hidden shadow-2xl"
         onclick="event.stopPropagation()">

        @* Progress bar *@
        <div class="absolute top-0 left-0 right-0 z-20 px-3 pt-3">
            <div class="w-full h-[3px] bg-white/30 rounded-full overflow-hidden">
                <div id="storyProgress"
                     class="h-full bg-white rounded-full"
                     style="width: 0%;">
                </div>
            </div>
        </div>

        @* Story full image *@
        <img id="storyImage"
             src=""
             alt="Story"
             class="w-full h-full object-cover" />

        @* Gradient overlay *@
        <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-transparent to-black/30"></div>

        @* User info at top *@
        <div class="absolute top-8 left-0 right-0 z-10 px-4 pt-3 flex items-center gap-3">
            <div class="w-11 h-11 rounded-full p-[2px] shrink-0
                bg-gradient-to-tr from-orange-400 via-pink-500 to-purple-500 shadow-md">
                <div class="w-full h-full rounded-full border-2 border-white overflow-hidden bg-gray-100">
                    <img id="storyUserPic"
                         src=""
                         alt="User"
                         class="w-full h-full object-cover" />
                </div>
            </div>
            <div class="flex flex-col">
                <span id="storyUserName" class="text-white font-semibold text-sm drop-shadow-md"></span>
                <span class="text-white/70 text-xs">Just now</span>
            </div>
        </div>

        @* Close button *@
        <button onclick="closeStory()"
                class="absolute top-8 right-4 z-20 w-8 h-8 rounded-full bg-black/30
            flex items-center justify-center hover:bg-black/50 transition-colors pt-3">
            <ion-icon name="close" class="text-white text-lg"></ion-icon>
        </button>

    </div>
</div>

@section Scripts {
    <script>
        let progressTimer = null;

        function openStory(imageUrl, profilePicUrl, userName) {
            document.getElementById('storyImage').src = imageUrl;
            document.getElementById('storyUserPic').src = profilePicUrl;
            document.getElementById('storyUserName').textContent = userName;

            const modal = document.getElementById('storyModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');

            // Reset then animate progress bar
            const progress = document.getElementById('storyProgress');
            progress.style.transition = 'none';
            progress.style.width = '0%';

            setTimeout(() => {
                progress.style.transition = 'width 5s linear';
                progress.style.width = '100%';
            }, 50);

            // Auto close after 5s
            clearTimeout(progressTimer);
            progressTimer = setTimeout(() => closeStory(), 5000);
        }

        function closeStory() {
            const modal = document.getElementById('storyModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');

            document.getElementById('storyProgress').style.width = '0%';
            document.getElementById('storyImage').src = '';
            clearTimeout(progressTimer);
        }

        function closeStoryBackdrop(event) {
            if (event.target === document.getElementById('storyModal')) {
                closeStory();
            }
        }
    </script>
}