@model GetUserProfileVM

<main id="site__main" class="2xl:ml-[--w-side] xl:ml-[--w-side-sm] p-2.5 h-[calc(100vh-var(--m-top))] mt-[--m-top] overflow-y-auto bg-gradient-to-br from-gray-50 via-white to-indigo-50/20">

    <style>
            /* ===== Animations & Enhanced UI ===== */
            @@keyframes fadeSlideUp {
                from {
                    opacity: 0;
                    transform: translateY(24px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@keyframes shimmer {
                0% {
                    background-position: -200% 0;
                }

                100% {
                    background-position: 200% 0;
                }
            }

            @@keyframes gentlePulse {
                0%, 100% {
                    transform: scale(1);
                    opacity: 0.6;
                }

                50% {
                    transform: scale(1.08);
                    opacity: 1;
                }
            }

            .profile-card, .sidebar-card {
                animation: fadeSlideUp 0.5s cubic-bezier(0.2, 0.9, 0.4, 1.1) forwards;
            }

            .sidebar-card {
                animation-delay: 0.05s;
            }

            .btn-effect {
                transition: all 0.2s ease;
            }

                .btn-effect:active {
                    transform: scale(0.96);
                }

            .btn-glow {
                transition: all 0.2s ease;
            }

                .btn-glow:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 10px 20px -5px rgba(79, 70, 229, 0.3);
                }

            .cover-shimmer {
                background: linear-gradient(110deg, transparent 8%, rgba(255,255,255,0.25) 18%, transparent 33%);
                background-size: 200% 100%;
                animation: shimmer 3s infinite;
            }

            .tab-active-highlight {
                position: relative;
            }

                .tab-active-highlight::after {
                    content: '';
                    position: absolute;
                    bottom: -2px;
                    left: 0;
                    width: 100%;
                    height: 2px;
                    background: linear-gradient(90deg, #6366f1, #a855f7);
                    border-radius: 2px;
                    animation: fadeSlideUp 0.2s ease;
                }

            .hover-lift {
                transition: transform 0.2s ease, box-shadow 0.2s ease;
            }

                .hover-lift:hover {
                    transform: translateY(-3px);
                    box-shadow: 0 20px 25px -12px rgba(0, 0, 0, 0.12);
                }

            .stat-number {
                transition: all 0.2s;
            }

            .stat-card:hover .stat-number {
                color: #4f46e5;
                transform: scale(1.02);
            }

            /* Toast notification */
            .toast-message {
                position: fixed;
                bottom: 24px;
                right: 24px;
                z-index: 1000;
                animation: fadeSlideUp 0.3s ease;
                backdrop-filter: blur(12px);
            }
    </style>

    <div class="max-w-[1065px] mx-auto pb-8">

        @* ── Profile Header Card (Enhanced) ── *@
        <div class="profile-card bg-white/80 backdrop-blur-sm shadow-xl rounded-2xl overflow-hidden border border-white/40 transition-all duration-300">

            @* Animated Cover with shimmer *@
            <div class="relative w-full h-48 bg-gradient-to-br from-indigo-500 via-purple-600 to-pink-500 overflow-hidden">
                <div class="absolute inset-0 cover-shimmer"></div>
                <div class="absolute inset-0 opacity-20"
                     style="background-image: radial-gradient(circle at 1px 1px, white 1.5px, transparent 0);
                background-size: 24px 24px;"></div>
            </div>

            @* Avatar & actions row *@
            <div class="px-6 pb-5">
                <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 -mt-12">

                    @* Avatar with ring & status *@
                    <div class="relative w-28 h-28 shrink-0 group">
                        <div class="w-28 h-28 rounded-2xl border-4 border-white shadow-xl overflow-hidden bg-gray-100
                            transition-all duration-300 group-hover:shadow-2xl">
                            <img src="@Url.Content(Model.User.ProfilePictureUrl ?? "~/images/avatar/user.png")"
                                 alt="@Model.User.FullName"
                                 class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                        </div>
                        <span class="absolute bottom-2 right-2 w-4 h-4 rounded-full bg-emerald-500 border-2 border-white shadow-sm animate-pulse"></span>
                    </div>

                    @* Action buttons with enhanced styles *@
                    <div class="flex items-center gap-2 sm:pb-1">
                        <button id="addFriendBtn"
                                class="btn-effect btn-glow flex items-center gap-1.5 px-5 py-2.5 rounded-xl text-sm font-semibold
                            bg-gradient-to-r from-indigo-500 to-purple-500 text-white shadow-md
                            hover:from-indigo-600 hover:to-purple-600 hover:shadow-indigo-200/50">
                            <ion-icon name="person-add-outline" class="text-base"></ion-icon>
                            Add Friend
                        </button>
                        <button class="btn-effect flex items-center gap-1.5 px-5 py-2.5 rounded-xl text-sm font-semibold
                            bg-gray-100 text-gray-700 hover:bg-gray-200 hover:shadow-sm transition-all">
                            <ion-icon name="chatbubble-outline" class="text-base"></ion-icon>
                            Message
                        </button>
                        <div class="relative group">
                            <button class="btn-effect w-10 h-10 rounded-xl bg-gray-100 hover:bg-gray-200
                                grid place-items-center transition-all">
                                <ion-icon name="ellipsis-horizontal" class="text-gray-600 text-lg"></ion-icon>
                            </button>
                            <div class="absolute right-0 top-full mt-1 w-36 bg-white rounded-xl shadow-lg border border-gray-100
                                opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-20">
                                <a href="#" class="flex items-center gap-2 px-3 py-2 text-xs text-gray-600 hover:bg-indigo-50 rounded-t-xl">Report</a>
                                <a href="#" class="flex items-center gap-2 px-3 py-2 text-xs text-gray-600 hover:bg-indigo-50 rounded-b-xl">Block</a>
                            </div>
                        </div>
                    </div>
                </div>

                @* Name, username & stats *@
                <div class="mt-4">
                    <h1 class="text-2xl font-extrabold bg-gradient-to-r from-gray-800 to-gray-600 bg-clip-text text-transparent">@Model.User.FullName</h1>
                    <p class="text-sm text-gray-400 mt-0.5">@@@Model.User.UserName</p>

                    <div class="flex items-center gap-8 mt-5">
                        <div class="stat-card group cursor-pointer transition-all">
                            <p class="stat-number text-xl font-bold text-gray-800 leading-none">@(Model.Posts?.Count() ?? 0)</p>
                            <p class="text-xs text-gray-400 font-medium mt-0.5 group-hover:text-indigo-500 transition-colors">Posts</p>
                        </div>
                        <div class="w-px h-8 bg-gradient-to-b from-transparent via-gray-200 to-transparent"></div>
                        <div class="stat-card group cursor-pointer transition-all">
                            <p class="stat-number text-xl font-bold text-gray-800 leading-none">
                                @(Model.Friends?.Count ?? 0)
                            </p>
                            <p class="text-xs text-gray-400 font-medium mt-0.5 group-hover:text-indigo-500 transition-colors">Friends</p>
                        </div>
                        <div class="w-px h-8 bg-gradient-to-b from-transparent via-gray-200 to-transparent"></div>
                        <div class="stat-card group cursor-pointer transition-all">
                            <p class="stat-number text-xl font-bold text-gray-800 leading-none">4.2K</p>
                            <p class="text-xs text-gray-400 font-medium mt-0.5 group-hover:text-indigo-500 transition-colors">Likes</p>
                        </div>
                    </div>
                </div>
            </div>

            @* Tabs with animated underline *@
            <div class="flex border-t border-gray-100/80 px-2 overflow-x-auto">
                @{
                    var tabs = new[] {
                        ("Posts",   "grid-outline"),
                        ("About",   "person-outline"),
                        ("Friends", "people-outline"),
                        ("Media",   "images-outline")
                    };
                }
                @foreach (var (label, icon) in tabs)
                {
                    bool active = label == "Posts";
                    <button class="tab-btn flex items-center gap-1.5 px-5 py-3 text-sm font-semibold whitespace-nowrap
                        transition-all duration-200 relative @(active ? "text-indigo-600 tab-active-highlight" : "text-gray-500 hover:text-gray-800")">
                        <ion-icon name="@icon" class="text-base"></ion-icon>
                        @label
                    </button>
                }
            </div>
        </div>

        @* ── Main Body (Posts + Sidebar) ── *@
        <div class="flex gap-6 mt-6 max-lg:flex-col items-start" id="js-oversized">

            @* Posts feed *@
            <div class="flex-1 min-w-0 space-y-5">
                @if (Model.Posts == null || !Model.Posts.Any())
                {
                    <div class="bg-white/80 backdrop-blur-sm rounded-2xl border border-gray-100 shadow-sm py-20 text-center animate-fadeSlideUp">
                        <div class="w-16 h-16 rounded-2xl bg-indigo-50 grid place-items-center mx-auto mb-4">
                            <ion-icon name="create-outline" class="text-4xl text-indigo-300"></ion-icon>
                        </div>
                        <p class="text-base font-semibold text-gray-700">No posts yet</p>
                        <p class="text-xs text-gray-400 mt-1.5">When @(Model.User.FullName) shares something, it will appear here.</p>
                    </div>
                }
                else
                {
                    @foreach (var post in Model.Posts)
                    {
                        <partial name="Home/_Post" model="post"
                                 view-data='new ViewDataDictionary(ViewData)
                                      {
                                          { "ShowAllComment", false },
                                          { "ShowDetails", false }
                                      }' />
                    }
                }
            </div>

            @* ── Sidebar (Enhanced sticky) ── *@
            <div class="lg:w-[320px] w-full shrink-0">
                <div class="space-y-5"
                     uk-sticky="media: 1024; end: #js-oversized; offset: 80">

                    @* Friends card with real count & hover effects *@
                    <div class="sidebar-card bg-white/80 backdrop-blur-sm rounded-2xl shadow-md border border-white/40 p-5 transition-all hover:shadow-lg">
                        <div class="flex items-center justify-between mb-4">
                            <div>
                                <h3 class="font-extrabold text-gray-800 text-base">Friends</h3>
                                <p class="text-xs text-gray-400 mt-0.5">@(Model.Friends?.Count ?? 0) mutual connections</p>
                            </div>
                            <a href="#" class="text-xs font-semibold text-indigo-500 hover:text-indigo-700 transition-all hover:underline">
                                See all
                                <ion-icon name="arrow-forward-outline" class="text-xs align-middle"></ion-icon>
                            </a>
                        </div>

                        <div class="grid grid-cols-3 gap-3">
                            @if (Model.Friends != null && Model.Friends.Any())
                            {
                                foreach (var friend in Model.Friends.Take(6))
                                {
                                    <div class="group cursor-pointer text-center transition-all">
                                        <div class="relative w-full aspect-square rounded-xl overflow-hidden bg-gray-100
                                            ring-2 ring-transparent group-hover:ring-indigo-300 transition-all duration-200 shadow-sm">
                                            <img src="@Url.Content(friend.ProfilePictureUrl ?? "~/images/avatar/user.png")"
                                                 alt="@friend.FullName"
                                                 class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-300" />
                                        </div>
                                        <p class="mt-1.5 text-[11px] font-medium text-gray-600 text-center truncate
                                            group-hover:text-indigo-600 transition-colors">
                                            @friend.FullName
                                        </p>
                                    </div>
                                }
                            }
                            else
                            {
                                for (int i = 0; i < 6; i++)
                                {
                                    <div class="group cursor-pointer text-center">
                                        <div class="relative w-full aspect-square rounded-xl overflow-hidden bg-gray-100
                                            ring-2 ring-transparent group-hover:ring-indigo-300 transition-all">
                                            <img src="~/images/avatar/user.png"
                                                 alt="friend"
                                                 class="object-cover w-full h-full group-hover:scale-105 transition-transform" />
                                        </div>
                                        <p class="mt-1 text-[10px] font-medium text-gray-500 truncate">✨ User</p>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    @* Photos card with gradient placeholders *@
                    <div class="sidebar-card bg-white/80 backdrop-blur-sm rounded-2xl shadow-md border border-white/40 p-5">
                        <div class="flex items-center justify-between mb-4">
                            <div>
                                <h3 class="font-extrabold text-gray-800 text-base">Photos</h3>
                                <p class="text-xs text-gray-400 mt-0.5">48 memories</p>
                            </div>
                            <a href="#" class="text-xs font-semibold text-indigo-500 hover:text-indigo-700 transition-all hover:underline">
                                See all
                                <ion-icon name="arrow-forward-outline" class="text-xs align-middle"></ion-icon>
                            </a>
                        </div>

                        <div class="grid grid-cols-3 gap-2">
                            @for (int i = 0; i < 9; i++)
                            {
                                <div class="relative w-full aspect-square rounded-xl overflow-hidden
                                    bg-gradient-to-br from-indigo-100 to-purple-100 cursor-pointer
                                    shadow-sm hover:shadow-md transition-all group">
                                    <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors z-10"></div>
                                    <ion-icon name="camera-outline" class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-indigo-300 text-xl opacity-0 group-hover:opacity-100 transition-opacity z-20"></ion-icon>
                                </div>
                            }
                        </div>
                    </div>

                    @* Bio / About card (extra touch) *@
                    <div class="sidebar-card bg-white/80 backdrop-blur-sm rounded-2xl shadow-md border border-white/40 p-5">
                        <h3 class="font-extrabold text-gray-800 text-base mb-2">About</h3>
                        <p class="text-xs text-gray-500 leading-relaxed">
                            @(Model.User.Bio ?? "No bio yet. Connect to learn more about this person.")
                        </p>
                        <div class="mt-3 flex items-center gap-2 text-xs text-gray-400">
                            <ion-icon name="calendar-outline"></ion-icon>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</main>

<script>
    // Simple toast notifier for demo/interactivity
    function showToast(message, type = 'success') {
        const existing = document.querySelector('.toast-message');
        if(existing) existing.remove();
        const toast = document.createElement('div');
        toast.className = `toast-message flex items-center gap-3 px-5 py-3 rounded-2xl shadow-2xl text-sm font-semibold backdrop-blur-md border ${
            type === 'success' ? 'bg-emerald-500/90 text-white border-emerald-300' : 'bg-rose-500/90 text-white border-rose-300'
        }`;
        toast.innerHTML = `<ion-icon name="${type === 'success' ? 'checkmark-circle' : 'warning'}" class="text-xl"></ion-icon> ${message}`;
        document.body.appendChild(toast);
        setTimeout(() => toast.style.animation = 'fadeSlideUp 0.3s reverse forwards', 2800);
        setTimeout(() => toast.remove(), 3300);
    }

    // Enhance Add Friend button with interactive state (simulated)
    document.addEventListener('DOMContentLoaded', () => {
        const addBtn = document.getElementById('addFriendBtn');
        if(addBtn) {
            let isPending = false;
            addBtn.addEventListener('click', (e) => {
                e.preventDefault();
                if(!isPending) {
                    addBtn.innerHTML = '<ion-icon name="time-outline" class="text-base"></ion-icon> Request Sent';
                    addBtn.classList.remove('bg-gradient-to-r', 'from-indigo-500', 'to-purple-500');
                    addBtn.classList.add('bg-amber-500', 'hover:bg-amber-600');
                    showToast('Friend request sent!', 'success');
                    isPending = true;
                } else {
                    showToast('Request already pending', 'info');
                }
            });
        }

        // Smooth tab switching simulation (for demo)
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.tab-btn').forEach(b => {
                    b.classList.remove('text-indigo-600', 'tab-active-highlight');
                    b.classList.add('text-gray-500');
                });
                this.classList.remove('text-gray-500');
                this.classList.add('text-indigo-600', 'tab-active-highlight');
                // Optional: load dynamic content here
                showToast(`Switched to ${this.innerText.trim()} view`, 'info');
            });
        });
    });
</script>