@model List<Post>
@{
    ViewData["Title"] = "Favorites";
}

<main id="site__main" class="2xl:ml-[--w-side] xl:ml-[--w-side-sm] p-2.5 h-[calc(100vh-var(--m-top))] mt-[--m-top]">
    <div class="lg:flex 2xl:gap-16 gap-12 max-w-[1065px] mx-auto" id="js-oversized">

        @* ── Main Column ── *@
        <div class="max-w-[680px] mx-auto w-full">

            @await Component.InvokeAsync("Stories")

            @* Favorites Header Banner *@
            <div class="relative overflow-hidden rounded-2xl mb-5
                bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500 p-5 shadow-md">
                @* Dot pattern overlay *@
                <div class="absolute inset-0 opacity-10 pointer-events-none"
                     style="background-image: radial-gradient(circle at 1px 1px, white 1.5px, transparent 0);
                background-size: 20px 20px;"></div>

                <div class="relative flex items-center gap-4">
                    <div class="w-12 h-12 rounded-xl bg-white/20 backdrop-blur-sm
                        grid place-items-center shrink-0 shadow-sm">
                        <ion-icon name="bookmark" class="text-white text-2xl"></ion-icon>
                    </div>
                    <div>
                        <h2 class="text-lg font-extrabold text-white leading-tight">Your Favorites</h2>
                        <p class="text-sm text-white/70 mt-0.5">
                            @Model.Count post@(Model.Count == 1 ? "" : "s") saved for later
                        </p>
                    </div>
                </div>
            </div>

            @* Create Post Box *@
            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm px-4 py-3 mb-4">
                <div class="flex items-center gap-3">
                    <div class="flex-1 px-4 py-2.5 rounded-xl bg-gray-50 border border-gray-100
                        text-sm text-gray-400 cursor-pointer hover:bg-indigo-50 hover:border-indigo-100
                        hover:text-indigo-400 transition-all duration-200 select-none"
                         uk-toggle="target: #create-status">
                        What's on your mind?
                    </div>
                    <button class="flex items-center gap-1.5 px-3 py-2 rounded-xl text-sm font-semibold
                        text-gray-500 bg-gray-50 border border-gray-100
                        hover:bg-indigo-50 hover:text-indigo-500 hover:border-indigo-100
                        transition-all duration-200"
                            uk-toggle="target: #create-status">
                        <ion-icon name="image-outline" class="text-base"></ion-icon>
                        Photo
                    </button>
                </div>
            </div>

            @* Posts *@
            @if (Model.Count == 0)
            {
                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm py-20 text-center">
                    <div class="w-16 h-16 rounded-2xl bg-indigo-50 grid place-items-center mx-auto mb-4">
                        <ion-icon name="bookmark-outline" class="text-4xl text-indigo-300"></ion-icon>
                    </div>
                    <h3 class="text-base font-bold text-gray-800 mb-1">No favorites yet</h3>
                    <p class="text-sm text-gray-400 max-w-xs mx-auto">
                        Bookmark posts you love and they'll appear here for easy access.
                    </p>
                </div>
            }

            <div class="space-y-3">
                @foreach (var post in Model)
                {
                    <partial name="Home/_Post" model="post"
                             view-data='new ViewDataDictionary(ViewData) { { "ShowAllComment", false } }' />
                }
            </div>

        </div>

        @* ── Sidebar ── *@
        <div class="flex-1 shrink-0">
            <div class="lg:space-y-4 lg:pb-8 max-lg:grid sm:grid-cols-2 max-lg:gap-6"
                 uk-sticky="media: 1024; end: #js-oversized; offset: 80">

                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5">
                    @await Component.InvokeAsync("SuggestedFriends")
                </div>

                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5">
                    @await Component.InvokeAsync("Hashtags")
                </div>
            </div>
        </div>

    </div>
</main>

<partial name="Modals/_CreateStory" model="new StoryVM()" />
<partial name="Modals/_CreateStatus" model="new PostVM()" />
<partial name="Home/_PostDeleteConfirmation" />

<script>
    function openPostDeleteConfirmation(postId) {
        var dropdown = UIkit.dropdown('.post-options-dropdown');
        if (dropdown) { dropdown.hide(false); }
        const postIdInput = document.getElementById('deletConfirmationPostId');
        if (postIdInput) { postIdInput.value = postId; }
        UIkit.modal('#postDeleteDialog').show();
    }
</script>
