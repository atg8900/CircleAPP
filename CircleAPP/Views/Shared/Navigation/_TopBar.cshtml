@inject UserManager<User> UserManager;

@{
    var loggedInUser = await UserManager.GetUserAsync(User);
    var userName = loggedInUser?.UserName;
    var fullName = loggedInUser?.FullName;
    var profilePictureUrl = loggedInUser?.ProfilePictureUrl;
}

<header class="z-[100] h-[--m-top] fixed top-0 left-0 w-full flex items-center" style="background:rgba(255,255,255,0.85);backdrop-filter:blur(20px);border-bottom:1px solid rgba(99,102,241,0.10);box-shadow:0 2px 20px rgba(99,102,241,0.08);">
    <div class="2xl:w-[--w-side] lg:w-[--w-side-sm]">
        <div class="flex items-center gap-1 px-3">
            <button uk-toggle="target: #site__sidebar ; cls :!-translate-x-0"
                    class="flex items-center justify-center w-9 h-9 text-xl rounded-full hover:bg-indigo-50 xl:hidden transition-all group"
                    style="color:#6366f1;">
                <ion-icon name="menu-outline" class="text-2xl group-aria-expanded:hidden"></ion-icon>
                <ion-icon name="close-outline" class="hidden text-2xl group-aria-expanded:block"></ion-icon>
            </button>

            <div id="logo" class="flex items-center gap-2">
                <a asp-controller="Home" class="flex items-center gap-2">
                    <div style="width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,#6366f1,#a855f7);display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(99,102,241,0.35);">
                        <ion-icon name="planet-outline" style="color:#fff;font-size:1.2rem;"></ion-icon>
                    </div>
                    <span style="background:linear-gradient(135deg,#6366f1,#a855f7);-webkit-background-clip:text;-webkit-text-fill-color:transparent;font-weight:800;font-size:1.15rem;letter-spacing:-0.02em;">Circle</span>
                </a>
            </div>
        </div>
    </div>

    <div class="flex-1 relative">
        <div class="max-w-[1220px] mx-auto flex items-center">
            <form id="search--box"
                  class="xl:w-[620px] sm:w-80 sm:relative rounded-full overflow-hidden z-20 max-md:hidden w-screen left-0 max-sm:fixed max-sm:top-2"
                  style="background:rgba(99,102,241,0.06);border:1.5px solid rgba(99,102,241,0.12);transition:all 0.25s ease;">
                <ion-icon name="search" class="absolute left-4 top-1/2 -translate-y-1/2" style="color:#6366f1;"></ion-icon>
                <input type="text" name="query" placeholder="Search posts, friends, hashtags..."
                       class="w-full !pl-11 !font-normal !bg-transparent h-11 !text-sm !border-0 !ring-0 !outline-none" />
            </form>
        </div>

        <div class="max-w-[1220px] mx-auto flex items-center">
            <div class="flex items-center sm:gap-3 gap-2 absolute right-4 top-1/2 -translate-y-1/2">

                @* Notification Button *@
                <div class="relative" id="notificationsBtn">
                    <button type="button"
                            class="relative flex items-center justify-center w-10 h-10 rounded-full transition-all hover:scale-110"
                            style="background:rgba(99,102,241,0.08);border:1.5px solid rgba(99,102,241,0.14);">
                        <ion-icon name="notifications-outline" style="font-size:1.3rem;color:#6366f1;"></ion-icon>
                        <div id="notificationsCount"
                             class="absolute -top-1 -right-1 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full min-w-[18px] text-center"
                             style="background:#ef4444;line-height:1.2;">0</div>
                    </button>

                    <div class="hidden bg-white pr-1.5 rounded-2xl drop-shadow-xl md:w-[380px] w-screen"
                         style="border:1px solid rgba(99,102,241,0.10);box-shadow:0 8px 40px rgba(99,102,241,0.18);"
                         uk-drop="offset:8;pos: bottom-right; mode: click; animate-out: true;">

                        <div class="flex items-center justify-between gap-2 p-4 pb-2 border-b"
                             style="border-color:rgba(99,102,241,0.08);">
                            <div class="flex items-center gap-2">
                                <div style="width:28px;height:28px;border-radius:8px;background:linear-gradient(135deg,#6366f1,#a855f7);display:flex;align-items:center;justify-content:center;">
                                    <ion-icon name="notifications" style="color:#fff;font-size:0.9rem;"></ion-icon>
                                </div>
                                <h3 class="font-bold text-base" style="color:#1e1b4b;">Notifications</h3>
                            </div>
                        </div>

                        <div class="text-sm h-[400px] w-full overflow-y-auto pr-2 py-2">
                            <div class="px-2 text-sm font-normal" id="notification-dropdown">
                                <div class="flex flex-col items-center justify-center h-32 text-gray-400">
                                    <ion-icon name="notifications-off-outline" class="text-3xl mb-2 opacity-40"></ion-icon>
                                    <span class="text-sm">No notifications yet</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* User Avatar + Dropdown *@
                <div class="relative cursor-pointer shrink-0">
                    <div class="p-0.5 rounded-full" style="background:linear-gradient(135deg,#6366f1,#a855f7);">
                        <img src="@(string.IsNullOrEmpty(profilePictureUrl) ? Url.Content("~/images/avatar/user.png") : Url.Content("~/"+profilePictureUrl))"
                             class="sm:w-9 sm:h-9 w-8 h-8 rounded-full object-cover border-2 border-white shrink-0" />
                    </div>

                    <div class="hidden bg-white rounded-2xl w-72"
                         style="box-shadow:0 8px 40px rgba(99,102,241,0.18);border:1px solid rgba(99,102,241,0.10);"
                         uk-drop="offset:8;pos: bottom-right;animate-out: true;">

                        @* User Header *@
                        <div style="background:linear-gradient(135deg,#6366f1,#a855f7);border-radius:16px 16px 0 0;padding:20px 16px 28px;">
                            <div class="flex items-center gap-3">
                                <img src="@(string.IsNullOrEmpty(profilePictureUrl) ? Url.Content("~/images/avatar/user.png") : Url.Content("~/"+profilePictureUrl))"
                                     class="w-12 h-12 rounded-full border-3 border-white shadow object-cover"
                                     style="border:3px solid rgba(255,255,255,0.8);" />
                                <div>
                                    <h4 class="font-bold text-white text-sm">@fullName</h4>
                                    <div class="text-white/70 text-xs mt-0.5">@@@userName</div>
                                </div>
                            </div>
                        </div>

                        @* Menu Items *@
                        <nav class="p-2">
                            <a asp-controller="Settings" asp-action="Index" class="block">
                                <div class="flex items-center gap-3 p-2.5 px-3 rounded-xl transition-all hover:bg-indigo-50 text-slate-700 hover:text-indigo-600">
                                    <div style="width:32px;height:32px;border-radius:8px;background:rgba(99,102,241,0.10);display:flex;align-items:center;justify-content:center;">
                                        <ion-icon name="settings-outline" style="color:#6366f1;font-size:1rem;"></ion-icon>
                                    </div>
                                    <span class="text-sm font-medium">Account Settings</span>
                                </div>
                            </a>
                            <hr style="border-color:rgba(99,102,241,0.08);margin:4px 0;">
                            <a asp-controller="Authentication" asp-action="Logout" class="block">
                                <div class="flex items-center gap-3 p-2.5 px-3 rounded-xl transition-all hover:bg-red-50 text-slate-700 hover:text-red-500">
                                    <div style="width:32px;height:32px;border-radius:8px;background:rgba(239,68,68,0.08);display:flex;align-items:center;justify-content:center;">
                                        <ion-icon name="exit-outline" style="color:#ef4444;font-size:1rem;"></ion-icon>
                                    </div>
                                    <span class="text-sm font-medium">Log Out</span>
                                </div>
                            </a>
                        </nav>
                    </div>
                </div>

            </div>
        </div>
    </div>
</header>

<script src="https://cdnjs.cloudflare.com/ajax/libs/aspnet-signalr/1.1.4/signalr.min.js"
integrity="sha512-hqwtOj6waHZZoLRoJoLn0tq34JS97tR1QmhM69uvyrt3LVBiR1o0xeOVAskjUFL1L1fahQH2W7IdcMaFbqCEaw=="
crossorigin="anonymous" referrerpolicy="no-referrer">
</script>

<script>
      document.addEventListener("DOMContentLoaded", () => {

        fetch("Notifications/GetCount", {
            method: 'GET',
            headers: {
                'Content-Type':'application/json'
            }
        })
            .then(response => response.json())
            .then(data => {
                console.log("notifications count = ", data);
                document.getElementById("notificationsCount").innerHTML = data;
            })
            .catch(error => {
                console.error("Error fetching notification count: ", error);
            })


               document.getElementById('notificationsBtn').addEventListener('click', () => {
            fetch('Notifications/GetNotifications')
                .then(resp => resp.text())
                .then(html => {
                    document.getElementById('notification-dropdown').innerHTML = html;
                })
        })

        //SignalR connection
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/notificationHub")
            .build();

        connection.on("ReceiveNotification", (message) => {
            console.log("message ==> ", message);

            document.getElementById("notificationsCount").innerHTML = message;
        });

        connection.start()
            .then(() => console.log("SignalR connected"))
            .catch((err) => console.log("SignalR connection error: ", err))

    })


       function setNotificationAsRead(notificationId) {
        console.log('Mark as read => notification => ', notificationId);

        fetch(`Notifications/SetNotificationAsRead?notificationId=${notificationId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        })
            .then(resp => resp.text())
            .then(html => {
                document.getElementById('notification-dropdown').innerHTML = html;
            })
    }

</script>