<div id="site__sidebar" class="fixed top-0 left-0 z-[99] pt-[--m-top] overflow-hidden transition-transform xl:duration-500 max-xl:w-full max-xl:-translate-x-full">
    <div class="p-3 2xl:w-72 sm:w-64 w-[80%] h-[calc(100vh-64px)] relative z-30"
         style="background:rgba(255,255,255,0.92);backdrop-filter:blur(16px);border-right:1px solid rgba(99,102,241,0.08);box-shadow:4px 0 24px rgba(99,102,241,0.07);">

        <div class="pr-2 h-full" data-simplebar>

            @* Main Navigation *@
            <nav id="side" class="mt-2">
                <ul class="space-y-1">
                    <li>
                        <a asp-controller="Home" asp-action="Index"
                           class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all group"
                           style="color:#475569;font-weight:500;font-size:0.9rem;">
                            <div class="w-9 h-9 rounded-xl flex items-center justify-center transition-all group-hover:scale-110"
                                 style="background:linear-gradient(135deg,#6366f1,#818cf8);box-shadow:0 4px 10px rgba(99,102,241,0.30);">
                                <ion-icon name="home" style="color:#fff;font-size:1.1rem;"></ion-icon>
                            </div>
                            <span class="font-medium" style="color:#334155;">Feed</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Favorites" asp-action="Index"
                           class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all group"
                           style="color:#475569;font-weight:500;font-size:0.9rem;">
                            <div class="w-9 h-9 rounded-xl flex items-center justify-center transition-all group-hover:scale-110"
                                 style="background:linear-gradient(135deg,#f59e0b,#f97316);box-shadow:0 4px 10px rgba(245,158,11,0.30);">
                                <ion-icon name="bookmark" style="color:#fff;font-size:1.1rem;"></ion-icon>
                            </div>
                            <span class="font-medium" style="color:#334155;">Favorites</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Friends"
                           class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all group"
                           style="color:#475569;font-weight:500;font-size:0.9rem;">
                            <div class="w-9 h-9 rounded-xl flex items-center justify-center transition-all group-hover:scale-110"
                                 style="background:linear-gradient(135deg,#10b981,#059669);box-shadow:0 4px 10px rgba(16,185,129,0.30);">
                                <ion-icon name="people" style="color:#fff;font-size:1.1rem;"></ion-icon>
                            </div>
                            <span class="font-medium" style="color:#334155;">Friends</span>
                        </a>
                    </li>
                </ul>
            </nav>

            @* Divider *@
            <div class="mx-3 my-4" style="border-top:1px solid rgba(99,102,241,0.10);"></div>

            @* Pages Section *@
            <nav id="side">
                <div class="px-3 pb-2">
                    <span class="text-xs font-semibold uppercase tracking-wider" style="color:#94a3b8;">Pages</span>
                </div>
                <ul class="space-y-1">
                    <li>
                        <a asp-controller="Settings" asp-action="Index"
                           class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all group"
                           style="color:#475569;font-weight:500;font-size:0.9rem;">
                            <div class="w-9 h-9 rounded-xl flex items-center justify-center transition-all group-hover:scale-110"
                                 style="background:linear-gradient(135deg,#64748b,#475569);box-shadow:0 4px 10px rgba(100,116,139,0.30);">
                                <ion-icon name="settings" style="color:#fff;font-size:1.1rem;"></ion-icon>
                            </div>
                            <span class="font-medium" style="color:#334155;">Settings</span>
                        </a>
                    </li>
                </ul>
            </nav>


        </div>
    </div>
    <div id="site__sidebar__overly"
         class="absolute top-0 left-0 z-20 w-screen h-screen xl:hidden backdrop-blur-sm"
         uk-toggle="target: #site__sidebar ; cls :!-translate-x-0"></div>
</div>