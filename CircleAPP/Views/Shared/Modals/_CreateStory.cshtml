@model StoryVM

<div class="hidden lg:p-20" id="create-story" uk-modal="">
    <div class="uk-modal-dialog tt relative overflow-hidden mx-auto bg-white md:w-[520px] w-full"
         style="border-radius:24px;box-shadow:0 24px 60px rgba(99,102,241,0.22);border:1px solid rgba(99,102,241,0.08);">

        @* Header *@
        <div class="relative py-4 px-6 flex items-center border-b"
             style="border-color:rgba(99,102,241,0.08);background:linear-gradient(135deg,rgba(99,102,241,0.04),rgba(168,85,247,0.03));">
            <div class="flex items-center gap-2.5 flex-1 justify-center">
                <div style="width:28px;height:28px;border-radius:8px;background:linear-gradient(135deg,#10b981,#059669);display:flex;align-items:center;justify-content:center;">
                    <ion-icon name="add-circle-outline" style="color:#fff;font-size:0.9rem;"></ion-icon>
                </div>
                <h2 class="font-bold text-base" style="color:#1e1b4b;">Create Story</h2>
            </div>
            <button type="button" class="button__ico uk-modal-close absolute right-4 top-1/2 -translate-y-1/2 w-8 h-8 flex items-center justify-center rounded-full transition-all hover:bg-red-50"
                    style="border:1.5px solid rgba(239,68,68,0.20);color:#f87171;background:none;cursor:pointer;">
                <ion-icon name="close-outline" style="font-size:1.2rem;"></ion-icon>
            </button>
        </div>

        <form asp-controller="Stories" asp-action="CreateStory" enctype="multipart/form-data">
            <div class="p-5">

                @* Upload Area *@
                <div class="w-full relative overflow-hidden rounded-2xl"
                     style="height:300px;background:linear-gradient(135deg,#f0f2f7,#e0e7ff);">

                    @* Background pattern *@
                    <div style="position:absolute;inset:0;background-image:radial-gradient(rgba(99,102,241,0.08) 1px,transparent 1px);background-size:20px 20px;"></div>

                    @* Upload label *@
                    <label id="storyUploadLabel"
                           class="absolute inset-0 flex flex-col items-center justify-center cursor-pointer z-10 transition-all"
                           style="background:linear-gradient(to top,rgba(99,102,241,0.15),transparent);">
                        <input id="storyUpload" name="image" type="file" accept="image/png, image/jpeg" hidden />
                        <div class="flex flex-col items-center gap-3">
                            <div style="width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,#6366f1,#a855f7);display:flex;align-items:center;justify-content:center;box-shadow:0 8px 20px rgba(99,102,241,0.35);">
                                <ion-icon name="camera-outline" style="color:#fff;font-size:1.8rem;"></ion-icon>
                            </div>
                            <div class="text-center">
                                <p id="storyUploadBtn" class="font-semibold text-sm" style="color:#6366f1;">Click to upload image</p>
                                <p class="text-xs mt-1" style="color:#94a3b8;">PNG or JPEG • Max 10 MB</p>
                            </div>
                        </div>
                    </label>

                    @* Preview image (hidden until chosen) *@
                    <img id="storyPreview" class="w-full h-full object-cover hidden" style="position:absolute;inset:0;z-index:5;" />
                </div>

                @* Duration note + Submit *@
                <div class="flex items-center justify-between mt-4">
                    <div class="flex items-center gap-2">
                        <div style="width:34px;height:34px;border-radius:10px;background:rgba(99,102,241,0.10);display:flex;align-items:center;justify-content:center;">
                            <ion-icon name="time-outline" style="color:#6366f1;font-size:1rem;"></ion-icon>
                        </div>
                        <div>
                            <p class="text-xs font-medium" style="color:#64748b;">Expires in <span style="color:#1e1b4b;font-weight:700;">24 hours</span></p>
                        </div>
                    </div>
                    <button type="submit"
                            class="px-6 py-2.5 rounded-xl font-bold text-sm text-white transition-all hover:opacity-90 hover:-translate-y-0.5"
                            style="background:linear-gradient(135deg,#10b981,#059669);box-shadow:0 4px 14px rgba(16,185,129,0.35);border:none;cursor:pointer;">
                        Share Story ✨
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    document.getElementById('storyUploadBtn').addEventListener('click', () => {
        document.getElementById('storyUpload').click();
    });

    document.getElementById('storyUpload').addEventListener('change', (event) => {
        const file = event.target.files[0];
        const storyPreview = document.getElementById('storyPreview');
        const storyUploadLabel = document.getElementById('storyUploadLabel');

        if (file) {
            const reader = new FileReader();
            reader.onload = (e) => {
                storyPreview.src = e.target.result;
                storyPreview.classList.remove('hidden');
                storyUploadLabel.style.display = 'none';
            }
            reader.readAsDataURL(file);
        } else {
            storyPreview.src = "";
            storyPreview.classList.add('hidden');
            storyUploadLabel.style.display = '';
        }
    });
</script>
