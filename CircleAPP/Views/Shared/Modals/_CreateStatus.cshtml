@model PostVM

<div class="hidden lg:p-20" id="create-status" uk-modal="">
    @* Modal Dialog - Updated for Responsive Width (Approx 50% / Static & Responsive) *@
    <div class="uk-modal-dialog tt relative overflow-hidden mx-auto bg-white shadow-2xl w-[95%] sm:w-4/5 md:w-1/2 lg:w-2/5 xl:w-1/3 min-w-[280px]"
         style="border-radius:24px;box-shadow:0 24px 60px rgba(99,102,241,0.22);border:1px solid rgba(99,102,241,0.08);max-height:90vh;overflow-y:auto;">

        @* Header *@
        <div class="relative py-4 px-6 flex items-center border-b"
             style="border-color:rgba(99,102,241,0.08);background:linear-gradient(135deg,rgba(99,102,241,0.04),rgba(168,85,247,0.03));">
            <div class="flex items-center gap-2.5 flex-1 justify-center">
                <div style="width:28px;height:28px;border-radius:8px;background:linear-gradient(135deg,#6366f1,#a855f7);display:flex;align-items:center;justify-content:center;">
                    <ion-icon name="create-outline" style="color:#fff;font-size:0.9rem;"></ion-icon>
                </div>
                <h2 class="font-bold text-base" style="color:#1e1b4b;">Create Post</h2>
            </div>
            <button type="button" class="uk-modal-close absolute right-4 top-1/2 -translate-y-1/2 w-8 h-8 flex items-center justify-center rounded-full transition-all hover:bg-red-50"
                    style="border:1.5px solid rgba(239,68,68,0.20);color:#f87171;">
                <ion-icon name="close-outline" style="font-size:1.2rem;"></ion-icon>
            </button>
        </div>

        @* Form *@
        <form asp-controller="Home" asp-action="CreatePost" enctype="multipart/form-data" method="post">
            <div class="p-5">
                <textarea class="w-full resize-none !border-0 !ring-0 !bg-transparent !text-xl !font-normal !text-slate-700 placeholder:!text-slate-400 focus:outline-none"
                          asp-for="Content"
                          rows="3"
                          style="max-height:120px;overflow-y:auto;"
                          placeholder="What's on your mind? ✨"></textarea>
            </div>

            @* Image Preview Container *@
            <div class="px-5">
                <div id="imagePreviewContainer" class="hidden relative w-full mb-4 rounded-xl overflow-hidden border"
                     style="border-color:rgba(99,102,241,0.15);max-height:220px;">
                    <img id="imagePreview" src="#" class="w-full object-cover" style="max-height:220px;" />
                    <button type="button" id="removeImageBtn"
                            class="absolute top-2 right-2 w-8 h-8 flex items-center justify-center rounded-full transition-all hover:scale-110"
                            style="background:rgba(0,0,0,0.55);border:none;cursor:pointer;color:#fff;">
                        <ion-icon name="close-outline" style="font-size:1.1rem;"></ion-icon>
                    </button>
                </div>
            </div>

            @* Footer Actions *@
            <div class="px-5 py-3 flex items-center gap-2 border-t" style="border-color:rgba(99,102,241,0.08);">
                <p class="text-xs font-medium mr-auto" style="color:#94a3b8;">Add to your post:</p>
                <input id="imageUpload" type="file" class="hidden" asp-for="Image" accept="image/png, image/jpeg" />
                <button type="button" id="imageUploadBtn"
                        class="flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold transition-all hover:scale-105"
                        style="background:rgba(14,165,233,0.10);color:#0ea5e9;border:1.5px solid rgba(14,165,233,0.20);">
                    <ion-icon name="image-outline" style="font-size:1rem;"></ion-icon>
                    Photo
                </button>
            </div>

            <div class="p-5 pt-3">
                <button type="submit"
                        class="w-full py-3 rounded-xl font-bold text-sm text-white transition-all hover:opacity-90 hover:-translate-y-0.5 active:translate-y-0"
                        style="background:linear-gradient(135deg,#6366f1,#4f46e5);box-shadow:0 4px 14px rgba(99,102,241,0.40);border:none;cursor:pointer;">
                    Share Post
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    const imageUpload = document.getElementById('imageUpload');
    const imageUploadBtn = document.getElementById('imageUploadBtn');
    const imagePreview = document.getElementById('imagePreview');
    const imagePreviewContainer = document.getElementById('imagePreviewContainer');
    const removeImageBtn = document.getElementById('removeImageBtn');

    imageUploadBtn.addEventListener('click', () => {
        imageUpload.click();
    });

    imageUpload.addEventListener('change', function() {
        const file = this.files[0];

        if (file) {
            const reader = new FileReader();

            reader.onload = function(e) {
                imagePreview.setAttribute('src', e.target.result);
                imagePreviewContainer.classList.remove('hidden');
            }

            reader.readAsDataURL(file);
        }
    });

    removeImageBtn.addEventListener('click', () => {
        imageUpload.value = "";
        imagePreview.setAttribute('src', "#");
        imagePreviewContainer.classList.add('hidden');
    });
</script>