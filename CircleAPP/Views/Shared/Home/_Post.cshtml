@using System.Security.Claims;
@model Post

@if (Model == null) { return; }

@{
    int loggedInUserId = int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out int result) ? result : 0;

    TimeSpan timeSpanSincePosted = DateTime.UtcNow.Subtract(Model.DateCreated);

    string displayTime = timeSpanSincePosted switch
    {
        var t when t.TotalDays >= 1 => $"{(int)t.TotalDays}d ago",
        var t when t.TotalHours >= 1 => $"{(int)t.TotalHours}h ago",
        var t when t.TotalMinutes >= 1 => $"{(int)t.TotalMinutes}m ago",
        _ => "Just now"
    };

    bool isFavorited = Model.Favorites.Any(n => n.UserId == loggedInUserId);
    bool isLiked = Model.Likes.Any(n => n.UserId == loggedInUserId);
    bool isPrivate = Model.IsPrivate == true && Model.UserId == loggedInUserId;
    bool isReported = Model.Reports.Any(n => n.UserId == loggedInUserId);

    string defaultUserPicture = "~/images/avatar/user.png";

    bool showAllComments = ViewData["ShowAllComment"] as bool? ?? false;
    bool showDetails = ViewData["ShowDetails"] as bool? ?? true;
}

<div id="post-@Model.Id" style="background:#fff;border-radius:16px;box-shadow:0 2px 8px rgba(99,102,241,0.08);border:1px solid rgba(99,102,241,0.09);overflow:hidden;transition:all 0.25s cubic-bezier(0.4,0,0.2,1);">

    @* ── Post Header ── *@
    <div class="flex items-center gap-3 px-4 pt-4 pb-2">

        @* Avatar with gradient ring *@
        <a asp-controller="Users" asp-action="Details" asp-route-userId="@Model.UserId" class="shrink-0">
            <div style="padding:2.5px;border-radius:50%;background:linear-gradient(135deg,#6366f1,#a855f7);">
                <img src="@(!string.IsNullOrEmpty(Model.User.ProfilePictureUrl)
                    ? Url.Content("~/" + Model.User.ProfilePictureUrl.TrimStart('/').Replace("\\", "/"))
                    : Url.Content("~/images/avatar/user.png"))"
                     style="width:40px;height:40px;border-radius:50%;border:2.5px solid #fff;object-fit:cover;display:block;" />
            </div>
        </a>

        <div class="flex-1 min-w-0">
            <a asp-controller="Users" asp-action="Details" asp-route-userId="@Model.UserId">
                <h4 class="font-semibold text-sm truncate" style="color:#1e1b4b;">@Model.User.FullName</h4>
            </a>
            <div class="text-xs mt-0.5 flex items-center gap-1.5" style="color:#94a3b8;">
                <ion-icon name="time-outline" style="font-size:0.75rem;"></ion-icon>
                <span title="@Model.DateCreated.ToString("MM/dd/yyyy HH:mm")">@displayTime</span>
                @if (isPrivate)
                {
                    <span class="ml-1 px-1.5 py-0.5 rounded-full text-[10px] font-semibold" style="background:rgba(99,102,241,0.10);color:#6366f1;">Private</span>
                }
            </div>
        </div>

        @* Options Menu *@
        <div class="-mr-1">
            <button type="button" class="button-icon w-8 h-8" style="background:rgba(99,102,241,0.06);border-radius:50%;">
                <ion-icon class="text-lg" name="ellipsis-horizontal" style="color:#64748b;"></ion-icon>
            </button>
            <div class="w-[220px] post-options-dropdown" uk-dropdown="pos: bottom-right; animation: uk-animation-scale-up uk-transform-origin-top-right; animate-out: true; mode: click">

                @if (Model.UserId == loggedInUserId)
                {
                    <form asp-controller="Home" asp-action="TogglePostVisibility">
                        <input type="hidden" name="postId" value="@Model.Id" />
                        <button type="submit" class="icon-link">
                            <ion-icon name="@(isPrivate ? "lock-open-outline" : "lock-closed-outline")" style="color:#6366f1;font-size:1rem;"></ion-icon>
                            Set as @(isPrivate ? "public" : "private")
                        </button>
                    </form>
                    <hr style="border-color:rgba(99,102,241,0.08);margin:4px 0;">
                    <button type="button" onclick="openPostDeleteConfirmation('@Model.Id')" class="delete-post-btn">
                        <ion-icon name="trash-bin-outline" style="font-size:1rem;"></ion-icon>
                        Delete Post
                    </button>
                }

                @if (!isReported)
                {
                    <hr style="border-color:rgba(99,102,241,0.08);margin:4px 0;">
                    <form asp-controller="Home" asp-action="AddPostReport">
                        <input type="hidden" name="postId" value="@Model.Id" />
                        <button type="submit" class="icon-link">
                            <ion-icon name="flag-outline" style="color:#f59e0b;font-size:1rem;"></ion-icon>
                            Report Post
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>

    @* ── Post Content ── *@
    @if (!string.IsNullOrWhiteSpace(Model.Content))
    {
        <a asp-controller="Home" asp-action="Details" asp-route-postId="@Model.Id">
            <div class="px-4 pb-3">
                <p class="text-sm leading-relaxed" style="color:#334155;font-weight:400;">@Model.Content</p>
            </div>
        </a>
    }

    @* ── Post Image ── *@
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        var normalizedPostImage = Url.Content("~/" + Model.ImageUrl.TrimStart('/').Replace("\\", "/"));
        <a asp-controller="Home" asp-action="Details" asp-route-postId="@Model.Id">
            <div class="w-full overflow-hidden" style="max-height:420px;">
                <img src="@normalizedPostImage" class="w-full object-cover transition-transform duration-500 hover:scale-[1.02]" style="max-height:420px;" />
            </div>
        </a>
    }

    @* ── Reactions Bar ── *@
    <div class="px-4 py-3 flex items-center gap-3" style="border-top:1px solid rgba(99,102,241,0.07);">

        @* Like *@
        <div class="flex items-center gap-1.5">
            <form asp-controller="Home" asp-action="TogglePostLike">
                @Html.AntiForgeryToken()
                <input type="hidden" name="postId" value="@Model.Id" />
                <button type="submit"
                        class="like-button button-icon transition-all @(isLiked ? "text-red-500" : "")"
                        style="@(isLiked ? "background:rgba(239,68,68,0.12);color:#ef4444;" : "background:rgba(99,102,241,0.07);color:#64748b;") width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;border:none;cursor:pointer;">
                    <ion-icon class="text-lg" name="@(isLiked ? "heart" : "heart-outline")"></ion-icon>
                </button>
            </form>
            <span class="text-xs font-semibold" style="color:@(isLiked ? "#ef4444" : "#64748b");">@Model.Likes.Count</span>
        </div>

        @* Comment *@
        <div class="flex items-center gap-1.5">
            <a class="button-icon" style="background:rgba(99,102,241,0.07);color:#6366f1;width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;">
                <ion-icon class="text-lg" name="chatbubble-ellipses-outline"></ion-icon>
            </a>
            <span class="text-xs font-semibold" style="color:#64748b;">@Model.Comments.Count</span>
        </div>

        <div class="ml-auto"></div>

        @* Bookmark *@
        <div class="flex items-center gap-1.5">
            <form asp-controller="Home" asp-action="TogglePostFavorite">
                <input type="hidden" name="postId" value="@Model.Id" />
                <button type="submit"
                        class="favorite-button button-icon transition-all @(isFavorited ? "text-orange-500" : "")"
                        style="@(isFavorited ? "background:rgba(245,158,11,0.12);color:#f59e0b;" : "background:rgba(99,102,241,0.07);color:#64748b;") width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;border:none;cursor:pointer;">
                    <ion-icon class="text-lg" name="@(isFavorited ? "bookmark" : "bookmark-outline")"></ion-icon>
                </button>
            </form>
            @if (Model.Favorites.Count > 0)
            {
                <span class="text-xs font-semibold" style="color:@(isFavorited ? "#f59e0b" : "#64748b");">@Model.Favorites.Count</span>
            }
        </div>
    </div>

    @* ── Comments Section ── *@
    @if (showDetails)
    {
        <div style="border-top:1px solid rgba(99,102,241,0.07);">

            @* Existing Comments *@
            @if (Model.Comments.Any())
            {
                <div class="px-4 pt-3 space-y-3">
                    @foreach (var comment in showAllComments
                                                ? Model.Comments.OrderByDescending(n => n.DateCreated)
                                                : Model.Comments.OrderByDescending(n => n.DateCreated).Take(2))
                    {
                        TimeSpan commentTimeSpanSincePosted = DateTime.UtcNow.Subtract(comment.DateCreated);
                        string commentDisplayTime = commentTimeSpanSincePosted switch
                        {
                            var t when t.TotalDays >= 1 => $"{(int)t.TotalDays}d ago",
                            var t when t.TotalHours >= 1 => $"{(int)t.TotalHours}h ago",
                            var t when t.TotalMinutes >= 1 => $"{(int)t.TotalMinutes}m ago",
                            _ => "Just now"
                        };

                        <div class="flex items-start gap-2.5">
                            <a asp-controller="Users" asp-action="Details" asp-route-userId="@comment.UserId" class="shrink-0 mt-0.5">
                                <img src="@(!string.IsNullOrEmpty(comment.User.ProfilePictureUrl)
                                    ? Url.Content("~/" + comment.User.ProfilePictureUrl.TrimStart('/').Replace("\\", "/"))
                                    : Url.Content("~/images/avatar/user.png"))"
                                     style="width:28px;height:28px;border-radius:50%;object-fit:cover;border:1.5px solid rgba(99,102,241,0.15);" />
                            </a>
                            <div class="flex-1 min-w-0">
                                <div class="rounded-xl rounded-tl-sm px-3 py-2" style="background:rgba(99,102,241,0.05);">
                                    <div class="flex items-center justify-between gap-2 mb-0.5">
                                        <a asp-controller="Users" asp-action="Details" asp-route-userId="@comment.UserId"
                                           class="text-xs font-semibold truncate" style="color:#1e1b4b;">@comment.User.FullName</a>
                                        <span class="text-[10px] shrink-0" style="color:#94a3b8;">@commentDisplayTime</span>
                                    </div>
                                    <p class="text-sm" style="color:#475569;">@comment.Content</p>
                                </div>
                            </div>
                            <form asp-controller="Home" asp-action="RemovePostComment" class="remove-comment-form shrink-0 mt-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="commentId" value="@comment.Id" />
                                <input type="hidden" name="postId" value="@comment.PostId" />
                                <button type="submit" title="Remove"
                                        style="background:none;border:none;cursor:pointer;color:#fca5a5;font-size:0.8rem;padding:4px;border-radius:6px;transition:all 0.2s;">
                                    <ion-icon name="trash-outline"></ion-icon>
                                </button>
                            </form>
                        </div>
                    }
                    @if (Model.Comments.Count >= 3 && !showAllComments)
                    {
                        <a asp-controller="Home" asp-action="Details" asp-route-postId="@Model.Id"
                           class="text-xs font-semibold block pb-1"
                           style="color:#6366f1;">See all @Model.Comments.Count comments →</a>
                    }
                </div>
            }

            @* Comment Input *@
            <form asp-controller="Home" asp-action="AddPostComment" class="add-comment-form">
                @Html.AntiForgeryToken()
                <div class="comment-input-wrap">
                    <a asp-controller="Users" asp-action="Details" asp-route-userId="@Model.UserId" class="shrink-0">
                        <img src="@(string.IsNullOrEmpty(Model.User.ProfilePictureUrl) ? Url.Content("~/images/avatar/user.png") : Url.Content(Model.User.ProfilePictureUrl))"
                             style="width:30px;height:30px;border-radius:50%;object-fit:cover;border:1.5px solid rgba(99,102,241,0.15);" />
                    </a>
                    <input type="hidden" name="postId" value="@Model.Id" />
                    <div class="flex-1 relative">
                        <textarea name="content" placeholder="Add a comment…"
                                  rows="1"
                                  class="w-full resize-none"
                                  style="background:rgba(99,102,241,0.05);border-radius:50px;border:1.5px solid rgba(99,102,241,0.10);padding:7px 16px;font-size:0.85rem;line-height:1.4;min-height:unset;"></textarea>
                    </div>
                    <button type="submit" class="comment-submit-btn">Post</button>
                </div>
            </form>
        </div>
    }

</div>