@model List<Notification>

@foreach (var notification in @Model)
{
    TimeSpan time = DateTime.UtcNow.Subtract(notification.DateCreated);
    string displayTxt = time switch
    {
        var t when t.TotalDays >= 1 => $"{(int)t.TotalDays}d ago",
        var t when t.TotalHours >= 1 => $"{(int)t.TotalHours}h ago",
        var t when t.TotalMinutes >= 1 => $"{(int)t.TotalMinutes}m ago",
        _ => "Just now"
    };

    string iconName = notification.Type switch
    {
        NotificationType.Favorite => "bookmark",
        NotificationType.Like => "heart",
        NotificationType.Comment => "chatbubbles",
        NotificationType.FriendRequest => "person-add",
        NotificationType.FriendRequestApproved => "people",
        _ => "notifications"
    };

    string iconClass = notification.Type switch
    {
        NotificationType.Favorite => "fav",
        NotificationType.Like => "like",
        NotificationType.Comment => "comment",
        NotificationType.FriendRequest => "friend",
        NotificationType.FriendRequestApproved => "friend",
        _ => "default"
    };

    string redirectUrl = notification.Type switch
    {
        NotificationType.FriendRequest => Url.Action("Index", "Friends"),
        NotificationType.FriendRequestApproved => Url.Action("Index", "Friends"),
        _ => Url.Action("Details", "Home", new { postId = notification.PostId })
    };

    <a href="@redirectUrl" class="block notif-row @(notification.IsRead ? "" : "unread")">
        <div class="notif-icon @iconClass">
            <ion-icon name="@iconName"></ion-icon>
        </div>
        <div class="flex-1 min-w-0">
            <p class="text-sm leading-snug" style="color:#334155;@(notification.IsRead ? "" : "font-weight:600;")">
                @notification.Message
            </p>
            <div class="text-xs mt-1" style="color:#94a3b8;">@displayTxt</div>
        </div>
        @if (!notification.IsRead)
        {
            <div onclick="setNotificationAsRead(@notification.Id)"
                 style="width:9px;height:9px;background:linear-gradient(135deg,#6366f1,#a855f7);border-radius:50%;flex-shrink:0;cursor:pointer;box-shadow:0 0 6px rgba(99,102,241,0.5);"
                 title="Mark as read"></div>
        }
    </a>
}