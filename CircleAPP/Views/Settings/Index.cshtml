@model User;

<main id="site__main" class="2xl:ml-[--w-side] xl:ml-[--w-side-sm] p-4 h-[calc(100vh-var(--m-top))] mt-[--m-top]">
    <div class="max-w-3xl mx-auto">

        @* Settings Card *@
        <div style="background:#fff;border-radius:20px;box-shadow:0 4px 24px rgba(99,102,241,0.12);border:1px solid rgba(99,102,241,0.08);overflow:hidden;">

            @* Gradient Banner *@
            <div style="background:linear-gradient(135deg,#6366f1,#a855f7);height:100px;position:relative;">
                <div style="position:absolute;top:-30px;right:-30px;width:160px;height:160px;border-radius:50%;background:rgba(255,255,255,0.07);"></div>
                <div style="position:absolute;bottom:-20px;left:40px;width:100px;height:100px;border-radius:50%;background:rgba(255,255,255,0.05);"></div>
            </div>

            @* Avatar + Name *@
            <form id="updateProfilePictureForm" class="relative" asp-controller="Settings" asp-action="UpdateProfilePicture" enctype="multipart/form-data">
                <div class="flex items-end justify-between px-6 pb-5" style="margin-top:-36px;">
                    <div class="relative shrink-0">
                        <label for="imageUpload" class="cursor-pointer block">
                            <img id="imagePreview"
                                 src="@(!string.IsNullOrEmpty(Model.ProfilePictureUrl) ? Model.ProfilePictureUrl : Url.Content("~/images/avatar/user.png"))"
                                 class="object-cover rounded-full"
                                 alt="Profile Picture"
                                 style="width:80px;height:80px;border:4px solid #fff;box-shadow:0 4px 16px rgba(99,102,241,0.20);" />
                            <input type="file" id="imageUpload" name="ProfilePictureImage" class="hidden" accept="image/png, image/jpeg" />
                        </label>
                        <label for="imageUpload"
                               class="absolute -bottom-1 -right-1 cursor-pointer flex items-center justify-center rounded-full"
                               style="width:26px;height:26px;background:linear-gradient(135deg,#6366f1,#a855f7);border:2px solid #fff;">
                            <ion-icon name="camera-outline" style="color:#fff;font-size:0.75rem;"></ion-icon>
                        </label>
                    </div>

                    <div class="flex-1 ml-4 mb-1">
                        <h3 class="text-lg font-bold" style="color:#1e1b4b;">@Model.FullName</h3>
                        <p class="text-sm" style="color:#6366f1;">@@@Model.UserName</p>
                    </div>
                    <button type="submit" id="saveButton" class="hidden font-semibold text-sm px-4 py-2 rounded-xl text-white"
                            style="background:linear-gradient(135deg,#6366f1,#4f46e5);border:none;cursor:pointer;box-shadow:0 4px 12px rgba(99,102,241,0.35);">Save Photo</button>
                </div>
            </form>

            @* Tab Navigation *@
            <div class="border-b" style="border-color:rgba(99,102,241,0.10);">
                <nav class="nav__underline px-6 p-0 border-transparent -mb-px">
                    <ul class="uk-slider-items w-[calc(100%+10px)] !overflow-hidden flex"
                        uk-switcher="connect: #setting_tab; animation: uk-animation-slide-right-medium, uk-animation-slide-left-medium">
                        <li class="w-auto pr-2.5">
                            <a href="#" class="flex items-center gap-1.5 py-3 px-2 font-semibold text-sm transition-all">
                                <ion-icon name="person-outline" style="font-size:1rem;"></ion-icon>
                                Update Profile
                            </a>
                        </li>
                        <li class="w-auto pr-2.5">
                            <a href="#" class="flex items-center gap-1.5 py-3 px-2 font-semibold text-sm transition-all">
                                <ion-icon name="lock-closed-outline" style="font-size:1rem;"></ion-icon>
                                Update Password
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>

            @* Tab Content *@
            <div id="setting_tab" class="uk-switcher py-8 px-8 overflow-hidden text-sm">

                @* --- Update Profile Tab --- *@
                <div>
                    <form asp-controller="Authentication" asp-action="UpdateProfile">
                        <div class="space-y-5">

                            @if (TempData["UserProfileError"] != null)
                            {
                                <div class="flex items-center gap-2 p-3 rounded-xl text-sm"
                                     style="background:rgba(239,68,68,0.08);color:#dc2626;border:1px solid rgba(239,68,68,0.15);">
                                    <ion-icon name="alert-circle-outline"></ion-icon>
                                    @TempData["UserProfileError"]
                                </div>
                            }

                            <div>
                                <label class="block text-xs font-semibold mb-1.5 uppercase tracking-wide" style="color:#94a3b8;">Full Name</label>
                                <input value="@Model.FullName" type="text" name="fullName" placeholder="Enter your full name" class="w-full" />
                            </div>
                            <div>
                                <label class="block text-xs font-semibold mb-1.5 uppercase tracking-wide" style="color:#94a3b8;">Username</label>
                                <input value="@Model.UserName" type="text" name="username" placeholder="Enter your username" class="w-full" />
                            </div>
                            <div>
                                <label class="block text-xs font-semibold mb-1.5 uppercase tracking-wide" style="color:#94a3b8;">Bio</label>
                                <textarea class="w-full" name="bio" rows="4" placeholder="Tell people about yourself…">@Model.Bio</textarea>
                            </div>

                            <div class="flex items-center gap-3 pt-2">
                                <button type="button" class="btn-ghost px-6 py-2.5 text-sm rounded-xl">Cancel</button>
                                <button type="submit"
                                        class="px-8 py-2.5 rounded-xl font-bold text-sm text-white transition-all hover:opacity-90"
                                        style="background:linear-gradient(135deg,#6366f1,#4f46e5);border:none;cursor:pointer;box-shadow:0 4px 14px rgba(99,102,241,0.35);">
                                    Save Changes
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                @* --- Update Password Tab --- *@
                <div>
                    <form asp-controller="Authentication" asp-action="UpdatePassword">
                        <div class="space-y-5">

                            @if (TempData["PasswordError"] != null)
                            {
                                <div class="flex items-center gap-2 p-3 rounded-xl text-sm"
                                     style="background:rgba(239,68,68,0.08);color:#dc2626;border:1px solid rgba(239,68,68,0.15);">
                                    <ion-icon name="alert-circle-outline"></ion-icon>
                                    @TempData["PasswordError"]
                                </div>
                            }

                            @if (TempData["PasswordSuccess"] != null)
                            {
                                <div class="flex items-center gap-2 p-3 rounded-xl text-sm"
                                     style="background:rgba(16,185,129,0.08);color:#059669;border:1px solid rgba(16,185,129,0.15);">
                                    <ion-icon name="checkmark-circle-outline"></ion-icon>
                                    @TempData["PasswordSuccess"]
                                </div>
                            }

                            <div>
                                <label class="block text-xs font-semibold mb-1.5 uppercase tracking-wide" style="color:#94a3b8;">Current Password</label>
                                <input type="password" name="currentPassword" placeholder="Enter current password" class="w-full" />
                            </div>
                            <div>
                                <label class="block text-xs font-semibold mb-1.5 uppercase tracking-wide" style="color:#94a3b8;">New Password</label>
                                <input type="password" name="newPassword" placeholder="Enter new password" class="w-full" />
                            </div>
                            <div>
                                <label class="block text-xs font-semibold mb-1.5 uppercase tracking-wide" style="color:#94a3b8;">Confirm New Password</label>
                                <input type="password" name="confirmPassword" placeholder="Confirm new password" class="w-full" />
                            </div>

                            <div class="flex items-center gap-3 pt-2">
                                <button type="button" class="btn-ghost px-6 py-2.5 text-sm rounded-xl">Cancel</button>
                                <button type="submit"
                                        class="px-8 py-2.5 rounded-xl font-bold text-sm text-white transition-all hover:opacity-90"
                                        style="background:linear-gradient(135deg,#6366f1,#4f46e5);border:none;cursor:pointer;box-shadow:0 4px 14px rgba(99,102,241,0.35);">
                                    Update Password
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</main>

<script>
    const imageUpload = document.getElementById('imageUpload');
    const imagePreview = document.getElementById('imagePreview');
    const saveButton = document.getElementById('saveButton');

    imageUpload.addEventListener('change', (event) => {
        const file = event.target.files[0];

        if (file) {
            const reader = new FileReader();
            reader.onload = (e) => {
                imagePreview.src = e.target.result;
                saveButton.classList.remove('hidden');
            }
            reader.readAsDataURL(file);
        } else {
            saveButton.classList.add('hidden');
        }
    });

    document.addEventListener('DOMContentLoaded', () => {
        const switcher = UIkit.switcher(document.querySelector('[uk-switcher]'));

        if ('@TempData["ActiveTab"]' === 'Password') {
            switcher.show(1);
        } else {
            switcher.show(0);
        }
    });

</script>